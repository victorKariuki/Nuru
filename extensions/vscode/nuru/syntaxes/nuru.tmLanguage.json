{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nuru Programming Language",
  "scopeName": "source.nr",
  "fileTypes": ["nr", "sw"],
  "patterns": [
    {"include": "#linecomments"},
    {"include": "#blockcomments"},
    {"include": "#operators"},
    {"include": "#punctuation"},
    {"include": "#numbers"},
    {"include": "#constant"},
    {"include": "#keywords"},
    {"include": "#strings"},
    {"include": "#identifiers"}
  ],
  "repository": {
    "linecomments": {
      "name": "comment.line.double-slash.nuru",
      "match": "(//).*$\\n?",
      "captures": {"1": {"name": "punctuation.definition.comment.nuru"}}
    },
    "blockcomments": {
      "name": "comment.block.nuru",
      "begin": "/\\*",
      "end": "\\*/",
      "captures": {"0": {"name": "punctuation.definition.comment.nuru"}}
    },
    "numbers": {
      "name": "constant.numeric.nuru",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "constant": {
      "name": "constant.language.nuru",
      "match": "\\b(kweli|sikweli|tupu)\\b"
    },
    "operators": {
      "patterns": [
        {"name": "keyword.operator.arithmetic.nuru", "match": "\\b(\\+|\\-|%|\\*\\*|\\*|\\/|\\^)\\b"},
        {"name": "keyword.operator.logical.nuru", "match": "\\b(==|!=|<=|>=|<|>|&&|\\|\\|)\\b"},
        {"name": "keyword.operator.assignment.nuru", "match": "\\b(=|:)\\b"},
        {"name": "punctuation.accessor.nuru", "match": "\\."}
      ]
    },
    "punctuation": {
      "patterns": [
        {"name": "punctuation.separator", "match": ","},
        {"include": "#groups"}
      ]
    },
    "groups": {
      "patterns": [
        {"name": "punctuation.group.nuru", "match": "[\\[\\)\\(\\]\\{\\}]"}
      ]
    },
    "keywords": {
      "patterns": [
        {"name": "storage.type.function.nuru", "match": "\\bunda\\b"},
        {"name": "storage.type.nuru", "match": "\\bfanya\\b"},
        {"name": "support.function.builtin.nuru", "match": "\\b(andika|_andika|jaza|aina|badilisha|namba|tungo|mfululizo|seta|jozi)\\b"},
        {"name": "keyword.control.nuru", "match": "\\b(kama|au|sivyo|wakati|rudisha|vunja|endelea|ktk|kwa|badili|ikiwa|kawaida|tumia|pakeji|jaribu|shika|bila)\\b"}
      ]
    },
    "identifiers": {
      "patterns": [
        {"name": "meta.functioncall.nuru", "match": "\\b([_A-Za-z][_A-Za-z0-9]*)\\b(?=\\()", "captures": {"1": {"name": "entity.name.function.nuru"}}}
      ]
    },
    "strings": {
      "patterns": [
        {"name": "string.quoted.double.nuru", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape.nuru", "match": "\\\\."}]},
        {"name": "string.quoted.single.nuru", "begin": "'", "end": "'", "patterns": [{"name": "constant.character.escape.nuru", "match": "\\\\."}]}
      ]
    }
  }
}
